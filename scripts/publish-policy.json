{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GrantedDashboardBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketWebsite",
        "s3:PutBucketPolicy",
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::granted-dashboard-2026"
    },
    {
      "Sid": "GrantedDashboardObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::granted-dashboard-2026/*"
    }
  ]
}
